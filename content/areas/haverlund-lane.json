    "inspections": [
      {
        "id": "shop-sign",
        "at": [
          10,
          14
        ],
        "title": "The workshop sign",
        "text": "A cast gear on a scrolled bracket, painted green over an older green. The bracket bolts are brighter than the wall around them."
      },
      {
        "id": "shop-window",
        "at": [
          10,
          16
        ],
        "title": "The shop window",
        "text": "Jars of screws sorted by size, a brass gear as big as a dinner plate, and a small enamel hand propped against the glass, waving at nobody."
      },
      {
        "id": "bicycle",
        "at": [
          10,
          9
        ],
        "title": "Nell's bicycle",
        "text": "Green frame, a wicker basket, a toolbag strapped behind the saddle. Wherever Nell went this morning, she walked."
      },
      {
        "id": "nell-door",
        "at": [
          10,
          19
        ],
        "title": "Nell's door",
        "text": "A plum door with a brass knocker shaped like a hand holding a ball. The step has been swept this morning. The boot scraper hasn't."
      },
      {
        "id": "lane-notices",
        "at": [
          17,
          6
        ],
        "title": "The notice board",
        "text": "Piano lessons, Thursdays. A dance at the hall. A drawing of a grey cat: ANSWERS TO PEPPER. DOES NOT COME WHEN CALLED."
      },
      {
        "id": "post-box",
        "at": [
          16,
          10
        ],
        "title": "The post box",
        "text": "Collections at nine and half past four. Someone has left a lost glove on top, palm down, so it can be seen from the lane."
      },
      {
        "id": "white-fence",
        "at": [
          10,
          25
        ],
        "title": "The white fence",
        "text": "Every picket the same height, the gate freshly painted. A card hangs from the latch: PAINT. — B."
      },
      {
        "id": "town-gate",
        "at": [
          12,
          26
        ],
        "title": "The gate at the steps",
        "text": "Steps drop away between the roofs toward the square. Someone has chalked a number on the top one: 212."
      },
      {
        "id": "view-bench",
        "at": [
          19,
          25
        ],
        "title": "The bench at the rail",
        "text": "From here the roofs fall away to the harbour. Down in the square, a small glass dome catches the light."
      },
      {
        "id": "telescope",
        "at": [
          21,
          26
        ],
        "title": "The telescope",
        "text": "A coin telescope on a cast-iron foot. It takes a coin you don't have, and it's been left pointing at the lighthouse."
      },
      {
        "id": "handcart",
        "at": [
          6,
          7
        ],
        "title": "The handcart",
        "text": "Chained to a ring in the wall: two empty crates, a coil of cable with its end taped, and a ledger with a pencil through the spine."
      },
      {
        "id": "tram-halt",
        "at": [
          18,
          2
        ],
        "title": "The tram halt",
        "text": "First car up at twenty to seven, then every twenty minutes. Beside the twenty-to-eight, in pencil: late."
      },
      {
        "id": "wall-spout",
        "at": [
          7,
          4
        ],
        "title": "The spout in the wall",
        "text": "A brass spout over a stone basin. It still runs, cold enough to ache, and the basin's lip is worn smooth on one side."
      },
      {
        "id": "street-sign",
        "at": [
          10,
          4
        ],
        "title": "The street sign",
        "text": "SPINDLE LANE, white on blue enamel, one corner chipped back to the iron. Someone has chalked an arrow under it, pointing up the steps."
      },
      {
        "id": "grey-cat",
        "at": [
          22,
          12
        ],
        "title": "A grey cat",
        "text": "Asleep on the warm coping with one paw over her nose. An ear turns toward you. The rest of her doesn't."
      }
    ]
  }
}
