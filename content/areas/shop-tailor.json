    "inspections": [
      {
        "id": "order-ticket",
        "at": [
          8,
          10
        ],
        "title": "The order book",
        "text": "Open on the board’s ledge. Fourteen finished orders, and a column headed COLLECTED with only two ticks in it. In the margin: they don’t know it’s ready. — G.F."
      },
      {
        "id": "cloth",
        "at": [
          1,
          3
        ],
        "title": "The cloth wall",
        "text": "Bolts rolled tight, sorted by colour, then by weight. A gap where the plum wool should be has a note pinned in it: ORDERED."
      },
      {
        "id": "coat-in-progress",
        "at": [
          3,
          8
        ],
        "title": "A coat on the stand",
        "text": "Navy, tacked together with white thread. The sleeves are pinned to the form’s shoulders, waiting. A paper tag: BRAUM — NOT BY LUNCH."
      },
      {
        "id": "spools",
        "at": [
          3,
          10
        ],
        "title": "The thread wall",
        "text": "A hundred and twenty-eight spools in rows of sixteen. Every row runs light to dark, except one, where two blues have swapped."
      },
      {
        "id": "gown",
        "at": [
          9,
          2
        ],
        "title": "The gown in the window",
        "text": "Wine velvet, with a blush sash. A card pinned to the hem: FOR THE BAND’S SINGER — SATURDAY. HEM NOT DONE."
      },
      {
        "id": "fitting-room",
        "at": [
          1,
          9
        ],
        "title": "The fitting booth",
        "text": "A curtain, a stool and a looking glass. Pinned inside the curtain, a list of measurements in a small hand, with one figure crossed out three times."
      },
      {
        "id": "buttons",
        "at": [
          9,
          4
        ],
        "title": "Buttons",
        "text": "Hundreds of them under the glass, sorted by colour and then by size. The fullest tray is labelled ODDS."
      }
    ],
