    "inspections": [
      {
        "id": "bake-order",
        "at": [
          7,
          10
        ],
        "title": "A note on the bake board",
        "text": "Pinned to the frame, in pencil, in a hand that presses hard: BOARD. PLEASE. PEOPLE KEEP KNOCKING ON THE BACK DOOR TO ASK WHEN. — A. KETTERING"
      },
      {
        "id": "bread-oven",
        "at": [
          1,
          9
        ],
        "title": "The oven",
        "text": "Warm right through the brick. KETTERING 1885 on the brass plate, polished where a sleeve rubs it. Somebody has chalked a row of ticks on the chimney, then rubbed half of them out."
      },
      {
        "id": "bread-racks",
        "at": [
          8,
          10
        ],
        "title": "The bread wall",
        "text": "Rounds on the left, tins on the right, plaits in the middle where people can see them. Each basket has a price tag, and a time pencilled on the back of the tag."
      },
      {
        "id": "proving-bowls",
        "at": [
          3,
          6
        ],
        "title": "Proving baskets",
        "text": "Dough rising in cane baskets. One basket has a pencil line inside the rim, a finger’s width above the dough."
      },
      {
        "id": "cake-table",
        "at": [
          2,
          3
        ],
        "title": "The cake table",
        "text": "Three tiers. On the top, a wedding cake with sugar roses and a card: FOR THE HALL — SATURDAY. DO NOT TOUCH. That has been underlined twice."
      },
      {
        "id": "station-clock",
        "at": [
          1,
          1
        ],
        "title": "The clock",
        "text": "Four minutes fast. On the frame, in pencil: so the bread is never late."
      },
      {
        "id": "mixer",
        "at": [
          5,
          9
        ],
        "title": "The mixer",
        "text": "Green enamel, a brass badge that says No 2, and a hand wheel for when the power drops. There is no No 1 anywhere in the shop."
      }
    ],
