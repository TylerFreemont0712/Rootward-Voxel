    "inspections": [
      {
        "id": "clock-display",
        "at": [
          9,
          4
        ],
        "title": "The display case",
        "text": "Mantel clocks and pocket watches wait on green felt. Each ivory tag records the maker, the fault found and the date the movement was serviced."
      },
      {
        "id": "clock-repairs",
        "at": [
          8,
          11
        ],
        "title": "The repair bench",
        "text": "A half-built escapement is held upright in its stand. Drivers, a bench vise and a shaded task lamp leave room for a larger calibration job."
      },
      {
        "id": "clock-parts",
        "at": [
          3,
          11
        ],
        "title": "Drawers of time",
        "text": "Brass labels divide pinions, springs, jewels and winding keys by size. The open repair manuals on top are full of small corrections."
      },
      {
        "id": "watch-collection",
        "at": [
          2,
          4
        ],
        "title": "Nine pocket watches",
        "text": "Chains hang from individual brass hooks. Open faces and closed cases share the cabinet, each with its own little stand and repair ticket."
      },
      {
        "id": "planetary-orrery",
        "at": [
          4,
          2
        ],
        "title": "A little clockwork sky",
        "text": "Three tilted brass orbits carry small planets around a golden sun. The exposed reduction wheels explain how one turn can become several slower ones."
      },
      {
        "id": "mainspring-winder",
        "at": [
          4,
          5
        ],
        "title": "The spring winder",
        "text": "Two iron jaws hold a coiled mainspring on its arbor. A wooden crank winds it under control; a handwritten note warns against releasing the jaws first."
      },
      {
        "id": "repair-intake",
        "at": [
          9,
          2
        ],
        "title": "The repair ledger",
        "text": "A ribbon marks the current page. The entries list owners, symptoms, promised collection dates and which parts are still missing."
      },
      {
        "id": "clock-oils",
        "at": [
          12,
          6
        ],
        "title": "Oils and cleaning tools",
        "text": "Fine applicators stand beside labelled bottles and a soft brush. The clockmaker uses different oils for pivots, springs and larger gear trains."
      },
      {
        "id": "clock-deliveries",
        "at": [
          11,
          8
        ],
        "title": "Clocks in transit",
        "text": "Slatted crates hold rolled felt and wrapped clock cases. Their brass straps and FRAGILE labels suggest careful deliveries rather than anonymous storage."
      },
      {
        "id": "pendulum-selection",
        "at": [
          11,
          9
        ],
        "title": "Pendulums awaiting regulation",
        "text": "Five rods hang from a numbered rack. The bobs have different masses and the lengths are deliberately unequal; each belongs to a particular movement."
      },
      {
        "id": "escapement-drawing",
        "at": [
          5,
          12
        ],
        "title": "The escapement drawing",
        "text": "A pinned diagram separates the escape wheel, pallet and pendulum. Dimension lines and small timing notes connect the drawing to the tools on the benches."
      },
      {
        "id": "bench-cleaning",
        "at": [
          3,
          8
        ],
        "title": "The watchmaker work station",
        "text": "A second workbench is arranged for smaller movements. Loose gears rest in a removable felt-lined tray, leaving the middle of the shop free for a larger task."
      },
      {
        "id": "cuckoo-stock",
        "at": [
          2,
          6
        ],
        "title": "The cuckoo clocks",
        "text": "A tiny carved bird waits under a steep roof. Two pinecone weights and a separate pendulum hang below the clock case."
      },
      {
        "id": "orrery-stock",
        "at": [
          12,
          3
        ],
        "title": "The demonstration model",
        "text": "A smaller planetary mechanism is mounted on a matching plinth. Its open rings can be examined without taking the larger display apart."
      }
    ],
    "city_network": true
  }
