      }
    ],
    "inspections": [
      {
        "id": "beacon-dial",
        "at": [
          23,
          8
        ],
        "title": "The pressure dial",
        "text": "The needle sits just past the first mark. Somebody has scratched a line in the brass where it used to rest."
      },
      {
        "id": "beacon-notices",
        "at": [
          20,
          7
        ],
        "title": "Notices on the beacon",
        "text": "A tide table, a meeting on Thursday, and a drawing of a lost tortoise called Admiral. Last seen heading for the harbour."
      },
      {
        "id": "beacon-door",
        "at": [
          24,
          11
        ],
        "title": "A small teal door",
        "text": "Locked. The keyhole is polished bright. Chalked on the step: BACK AT 4."
      },
      {
        "id": "beacon-glass",
        "at": [
          17,
          13
        ],
        "title": "The beacon",
        "text": "Up close, the root moves. Not much. About as much as someone asleep."
      },
      {
        "id": "hall-counter",
        "at": [
          20,
          23
        ],
        "title": "Enquiries",
        "text": "A brass bell, a ledger open at today and a mug gone cold. The clerk’s chair is turned to the window."
      },
      {
        "id": "hall-clock",
        "at": [
          24,
          23
        ],
        "title": "The guild hall clock",
        "text": "Ten past nine. The bakery says five past. Nobody’s sure which to believe."
      },
      {
        "id": "post-office",
        "at": [
          33,
          23
        ],
        "title": "Post Office",
        "text": "Parcels in brown paper, every one tied with the same knot. One is addressed in pencil to the lighthouse."
      },
      {
        "id": "post-box",
        "at": [
          29,
          23
        ],
        "title": "The post box",
        "text": "Last collection 5.15. Someone has posted a pine cone. It’s still in the slot."
      },
      {
        "id": "public-notices",
        "at": [
          26,
          22
        ],
        "title": "Guild notices",
        "text": "The beacon’s quarterly reading, a call for volunteers to repaint the railings, and a reward for a lost brass key."
      },
      {
        "id": "bakery",
        "at": [
          7,
          4
        ],
        "title": "Morning Loaf",
        "text": "The racks are half empty already. A card in the window: SECOND BATCH AT ELEVEN."
      },
      {
        "id": "greengrocer",
        "at": [
          7,
          9
        ],
        "title": "The greengrocer",
        "text": "Oranges stacked into a careful pyramid. One is missing from the very top."
      },
      {
        "id": "bookshop",
        "at": [
          7,
          14
        ],
        "title": "Finch & Sons",
        "text": "A tray of books at a penny each. On top, a tide almanac eleven years out of date."
      },
      {
        "id": "flower-stall",
        "at": [
          25,
          1
        ],
        "title": "The flower stall",
        "text": "Buckets of sweet peas and stocks, and a jam jar of coins nobody is minding."
      },
      {
        "id": "fruit-stall",
        "at": [
          11,
          7
        ],
        "title": "The fruit stall",
        "text": "Apples, pears, a crate of lemons. The scale is still swinging from the last customer."
      },
      {
        "id": "tally",
        "at": [
          12,
          5
        ],
        "title": "Tally",
        "text": "“FOUR PENCE. STOP. PLEASE COUNT IT. STOP. PLEASE COUNT IT AGAIN. STOP.”"
      },
      {
        "id": "heron",
        "at": [
          28,
          9
        ],
        "title": "Heron",
        "text": "The crate swings an inch and stops. “I. AM. WAITING. FOR. THE. WIND. STOP.”"
      },
      {
        "id": "tender",
        "at": [
          17,
          7
        ],
        "title": "Tender",
        "text": "It’s watching a valve wheel as if it might do something. “CHECKING. STILL CHECKING. STOP.”"
      },
      {
        "id": "wick",
        "at": [
          26,
          15
        ],
        "title": "Wick",
        "text": "“IT IS 9.14. LAMP TWO IS NOT DUE UNTIL 19.40. I AM EARLY. STOP.”"
      },
      {
        "id": "timber",
        "at": [
          31,
          8
        ],
        "title": "Building timber",
        "text": "Planks stacked to dry, chalked with a guild mark and a date. A tarpaulin tied over the best of it."
      },
      {
        "id": "shade-tree",
        "at": [
          29,
          12
        ],
        "title": "The plane tree",
        "text": "Initials cut into the seat: R.W. Varnished over more than once."
      },
      {
        "id": "south-view",
        "at": [
          18,
          0
        ],
        "title": "Over the rail",
        "text": "Roofs all the way down to the water. One chimney below is close enough to warm your hands at."
      },
      {
        "id": "east-view",
        "at": [
          35,
          17
        ],
        "title": "The yard wall",
        "text": "Down below, a man is carrying a ladder sideways along a street too narrow for it."
      },
      {
        "id": "street-steps",
        "at": [
          8,
          23
        ],
        "title": "Spindle Steps",
        "text": "The way back up to the lane. Chalked on the bottom step: 212. Under it, in other chalk: LIAR. 213."
      },
      {
        "id": "terrace-gate",
        "at": [
          11,
          24
        ],
        "title": "The terrace gate",
        "text": "Shut, with a bicycle chain round it. PRIVATE GARDEN. TOMATOES COUNTED."
      }
    ],
