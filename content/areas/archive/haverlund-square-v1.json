    "inspections": [
      {
        "id": "rootwell-dial",
        "at": [
          17,
          10
        ],
        "title": "The pressure dial",
        "text": "The needle rests near the red. Behind the glass, a root curls round a warm point of light. Four brass lines leave the stonework beneath your feet."
      },
      {
        "id": "rootwell-rim",
        "at": [
          20,
          13
        ],
        "title": "The Rootwell",
        "text": "The brass has been polished along the edge people lean on. Further round, a small patch keeps its green."
      },
      {
        "id": "bakery-step",
        "at": [
          7,
          5
        ],
        "title": "Morning Loaf",
        "text": "The window is misted along the bottom. On the cooling rack, someone has cut one loaf while it was still too warm."
      },
      {
        "id": "book-trays",
        "at": [
          7,
          14
        ],
        "title": "Finch & Sons",
        "text": "Maps outside, novels under the awning. A string holds the cheapest ones down; the others have stones on them."
      },
      {
        "id": "grocer-crates",
        "at": [
          7,
          21
        ],
        "title": "The greengrocer",
        "text": "The pears sit in folded newspaper. One crate is marked for Spindle Lane, with NELL written across the old address."
      },
      {
        "id": "market-scales",
        "at": [
          24,
          16
        ],
        "title": "The market scales",
        "text": "The empty pans hang level. Half a carrot has been put in the little drawer with the weights."
      },
      {
        "id": "flower-baskets",
        "at": [
          24,
          7
        ],
        "title": "The lower stall",
        "text": "The crates smell of apples. A wasp has found the only bruised one and is keeping it."
      },
      {
        "id": "cafe-paper",
        "at": [
          9,
          6
        ],
        "title": "A table by the shops",
        "text": "A ring of tea has caught the corner of the morning paper. The crossword has one word filled in, then crossed out."
      },
      {
        "id": "hall-door",
        "at": [
          15,
          20
        ],
        "title": "The town hall",
        "text": "Under the glass beside the handles: PUBLIC COUNTER, TEN O’CLOCK. The clock above says a little after eight."
      },
      {
        "id": "square-notices",
        "at": [
          22,
          23
        ],
        "title": "The public notices",
        "text": "A harbour closure, a lost parcel, the dates of the summer dances. The latest sheet has been pinned through the old pinholes."
      },
      {
        "id": "postal-cart",
        "at": [
          10,
          18
